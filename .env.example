# --- App ports (§10) ---
PORT=8080
FRONTEND_PORT=5174

# --- Events store (§6) ---
# Observability is always on. The store backend is swappable; sqlite is the default.
# EVENTS_BACKEND=sqlite
# EVENTS_DB_PATH=events.db
# Live call transcripts share that file; older ones are deleted at startup.
# TRANSCRIPT_RETENTION_DAYS=7

# --- Twilio credentials (all required by Twilio Agent Connect) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=

# Public host Twilio reaches this app on — no scheme, e.g. abc123.ngrok.app.
# TAC's TWILIO_VOICE_PUBLIC_DOMAIN defaults to this.
PUBLIC_HOST=

# --- TAC mode ---
# Leave empty for ConversationRelay-only mode (voice works with the credentials above).
# Set it to turn on Conversation Orchestrator + Conversation Memory:
# conv_configuration_<26 chars>, from the Twilio Console.
TWILIO_CONVERSATION_CONFIGURATION_ID=
# Orchestrated mode only — Enterprise Knowledge base for knowledge_lookup
# (falls back to the sample answers when unset).
TWILIO_KNOWLEDGE_BASE_ID=
# Orchestrated mode only — Studio flow for the handoff (e.g. Flex). When unset, the
# handoff is the PSTN warm transfer to OFFICE_PHONE_NUMBER.
TWILIO_STUDIO_HANDOFF_FLOW_SID=

# TAC sends usage telemetry (no message content or phone numbers). Set true to opt out.
TAC_ANALYTICS_DISABLED=

# --- Clinic ---
# Time zone for "today" in the agent's prompt and the appointment calendar.
CLINIC_TIMEZONE=America/New_York

# --- Voice ---
# ElevenLabs <voiceId>-<model>-<speed>_<stability>_<similarity>. The prompt uses v4 audio
# tags ([warmly], [sighs], [slowly]); on flash_v2_5/turbo_v2_5 they'd be read aloud.
RELAY_VOICE=21m00Tcm4TlvDq8ikWAM-v4-1.0_0.35_0.75
RELAY_LANGUAGE=
# E.164 number the warm transfer dials.
OFFICE_PHONE_NUMBER=

# --- Runtime agent (LangChain) ---
# Which model runs the agent, as provider:model. Default: anthropic:claude-opus-5-5.
# Any LangChain provider works once its @langchain/* package is installed, e.g.
#   LLM_MODEL=openai:gpt-5.4-mini            (ships with this app)
#   LLM_MODEL=google-genai:gemini-3-flash    (npm install @langchain/google-genai)
LLM_MODEL=
LLM_MAX_TOKENS=
# Set the key for the provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Claude only — reasoning effort (default low; voice is latency-sensitive).
ANTHROPIC_EFFORT=
