# --- App ports (§10) ---
PORT=8080
FRONTEND_PORT=5174

# --- Events store (§6) ---
# Observability is always on. The store backend is swappable; sqlite is the default.
# EVENTS_BACKEND=sqlite
# EVENTS_DB_PATH=events.db

# --- Twilio credentials ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# --- Integration variables (components + runtime agent) ---
# The runtime agent is OpenAI, configured here from this app's own environment.
# It is independent of whatever LLM generated this project.
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_HOST=
RELAY_VOICE=
RELAY_LANGUAGE=
OFFICE_PHONE_NUMBER=
RELAY_ACTION_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
